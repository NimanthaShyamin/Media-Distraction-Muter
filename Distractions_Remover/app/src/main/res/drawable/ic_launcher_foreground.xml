<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        AdMute launcher foreground — white muted speaker + red ✕
        Designed to sit on the green background (ic_launcher_background.xml).
        All artwork lives inside the 72×72 safe zone (18dp inset on each side).
    -->

    <!-- ── Speaker body (left rectangle) ─────────────────────────────────── -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M39,43 L39,65 L47,65 L47,43 Z" />

    <!-- ── Speaker cone (triangle pointing right) ─────────────────────────── -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M47,38 L47,70 L63,57 L63,51 Z" />

    <!-- ── Red ✕ — two thick diagonal strokes ─────────────────────────────── -->
    <!-- Stroke 1: top-left → bottom-right -->
    <path
        android:fillColor="#E53935"
        android:pathData="
            M65,42 L70,42 L80,66 L75,66 Z
            M65,66 L70,66 L80,42 L75,42 Z" />

    <!-- Cleaner single-path ✕ using rotated rectangles rendered as filled paths -->
    <path
        android:fillColor="#E53935"
        android:pathData="
            M64.5,40.5
            L69.5,40.5
            L81.5,67.5
            L76.5,67.5
            Z" />
    <path
        android:fillColor="#E53935"
        android:pathData="
            M76.5,40.5
            L81.5,40.5
            L69.5,67.5
            L64.5,67.5
            Z" />

</vector>