    <string name="wizard_step1_label">STEP 1 OF 2</string>
    <string name="wizard_step1_title">Unlock Android\nRestrictions</string>
    <string name="wizard_step1_body">Because AdMute was installed outside the Play Store, Android hides its advanced permissions by default.\n\nTo fix this:\n\n1. Tap "Open App Settings" below.\n2. In the App Info screen, tap the ⋮ three-dot menu in the top-right corner.\n3. Tap "Allow restricted settings".\n\nOnce done, tap "I\'ve Done This" to continue.</string>
    <string name="wizard_step1_hint">↑  Tap the ⋮ menu in the top-right, then tap "Allow restricted settings"</string>
